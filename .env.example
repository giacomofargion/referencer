# Clerk — create an app at https://dashboard.clerk.com
# Enable Google as the only social provider for v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon Postgres
DATABASE_URL=

# Cloudflare R2 — create bucket + API token at https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=referencer-audio

# Cyanite.ai (required) — uploads the unreleased mix and searches Spotify for
# similar commercial tracks. Free testing via https://cyanite.ai/integrate/
# Create an integration at https://cyanite.ai → get access token.
# Webhook is optional for local use (we poll analysis status instead).
# When deploying publicly, set webhook URL to:
#   https://YOUR_DOMAIN/api/cyanite/webhook
CYANITE_ACCESS_TOKEN=
# CYANITE_WEBHOOK_SECRET=

# Stripe — one-time credit purchases (https://dashboard.stripe.com)
# Local webhook: stripe listen --forward-to localhost:3000/api/credits/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price per credit in GBP pence (default 190 = £1.90)
CREDIT_PRICE_CENTS=190
# One-time free credits for new users (default 2)
FREE_STARTER_CREDITS=2
