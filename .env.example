# Clerk — create an app at https://dashboard.clerk.com
# Enable Google as the only social provider for v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Neon Postgres
DATABASE_URL=

# Cloudflare R2 — create bucket + API token at https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=referencer-audio

# Owner accounts — unlimited free matches (no credit spend).
# Comma-separated Clerk user IDs, or a single ID.
# OWNER_CLERK_USER_ID=user_xxx
# OWNER_CLERK_USER_IDS=user_xxx,user_yyy

# MERT embed worker — embeds uploads + ANN over the R2/local catalog.
# Host this URL in production so all users share the same path.
# See workers/mert-embed/README.md
# EMBED_WORKER_URL=http://127.0.0.1:8091
# Optional: R2 object key for the packed catalog (worker downloads if no local path)
# R2_CATALOG_KEY=catalog/mert-v1-95m.npz
# A/B: skip Essentia metering re-rank (pure MERT order). Default off.
# MATCH_SKIP_ESSENTIA_RERANK=true

# Stripe — one-time credit purchases (https://dashboard.stripe.com/apikeys)
# Local/dev: use Test mode keys (sk_test_… / pk_test_…) + `stripe listen`.
# Production (Vercel): use Live mode keys (sk_live_… / pk_live_…) and a
# Dashboard webhook endpoint → https://YOUR_DOMAIN/api/credits/webhook
# (event: checkout.session.completed). Paste that endpoint’s signing secret
# into STRIPE_WEBHOOK_SECRET for Production — do not reuse the `stripe listen` whsec.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Base price per credit in GBP pence (default 49 = £0.49).
# Volume packs: 5@49p, 20@39p, 50@35p, 100@29p (see CREDIT_PACKS in src/lib/credits.ts)
CREDIT_PRICE_CENTS=49
# One-time free credits for new users (default 5)
FREE_STARTER_CREDITS=5
