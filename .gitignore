# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MERT worker local catalog + venv
/workers/mert-embed/.venv/
/workers/mert-embed/data/
/workers/mert-embed/models/*.pb

# Large Discogs TF.js shards (downloaded by scripts/download-discogs-tfjs.sh / prebuild)
/public/models/discogs-genre/*.bin
/public/models/discogs-genre/model.json
# labels.json is small and committed

# Kaggle embedding dump (multi-GB) — do not commit
/archive/
